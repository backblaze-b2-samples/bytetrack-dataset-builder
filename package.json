{
  "name": "bytetrack-dataset-builder",
  "private": true,
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @bytetrack-dataset-builder/web dev",
    "dev:api": "cd services/api && .venv/bin/uvicorn main:app --reload --port ${API_PORT:-8000}",
    "build": "pnpm --filter @bytetrack-dataset-builder/web build",
    "typecheck": "pnpm --filter @bytetrack-dataset-builder/web typecheck",
    "lint": "pnpm --filter @bytetrack-dataset-builder/web lint",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "build:dataset": "cd services/api && .venv/bin/python scripts/build_dataset.py",
    "test:e2e": "pnpm --filter @bytetrack-dataset-builder/web exec playwright test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20.18.1",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "hono": "^4.13.5",
      "@hono/node-server": "^1.19.15",
      "ajv@6": "^6.14.0",
      "ajv@8": "^8.18.0",
      "minimatch@3": "^3.1.4",
      "minimatch@9": "^9.0.7",
      "minimatch@10": "^10.2.3",
      "flatted": "^3.4.2",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "path-to-regexp": "^8.4.0",
      "lodash": "^4.18.1",
      "express-rate-limit": "^8.2.2",
      "ip-address": "^10.3.1",
      "qs": "^6.16.0",
      "js-yaml": "^4.3.1",
      "body-parser": "^2.3.0",
      "fast-uri": "^3.1.6",
      "postcss-selector-parser": "^7.1.3",
      "browserslist": "^4.28.7",
      "@humanfs/node": "^0.16.8",
      "sharp": "^0.35.4",
      "postcss": "^8.5.26"
    }
  }
}
