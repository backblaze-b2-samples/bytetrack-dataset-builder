# Backblaze B2 (required)
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# Region drives the S3 endpoint (https://s3.{B2_REGION}.backblazeb2.com).
B2_REGION=us-west-004
# Public base URL for objects (optional — used to build shareable links).
B2_PUBLIC_URL_BASE=

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=K001-EXAMPLE-not-a-real-key-xxxxxxxx
# B2_BUCKET_NAME=my-tracking-datasets
# B2_REGION=us-west-004
# B2_PUBLIC_URL_BASE=https://my-tracking-datasets.s3.us-west-004.backblazeb2.com

# --- Tracking-dataset builder pipeline (local OSS — no remote inference API) ---
# The default detector `rfdetr-base` is a pre-trained COCO model served by
# Roboflow `inference` LOCALLY with NO API key; weights auto-download on first
# use. ROBOFLOW_API_KEY is OPTIONAL (unlocks Universe models / hosted
# inference) and is NOT required — leave it empty to run keyless.
ROBOFLOW_API_KEY=
DETECTION_MODEL=rfdetr-base

# On-B2 layout prefixes.
RAW_PREFIX=raw/
DATASET_PREFIX=dataset/

# Local CV engine knobs (CPU-friendly defaults; device is auto-detected
# CUDA -> MPS -> CPU at runtime — set DEVICE=cpu|cuda|mps to force one).
DEVICE=auto

# COCO class names ByteTrack keeps (comma-separated, case-insensitive).
# Default = surveillance / dashcam set.
TRACK_CLASSES=person,car,truck,bus,bicycle,motorcycle

# Detector + tracker thresholds and the CPU-demo frame cap (overridable per
# dataset build). MAX_FRAMES caps a CPU demo at a few hundred frames so a build
# completes fast.
DETECTION_CONFIDENCE=0.25
TRACK_ACTIVATION_THRESHOLD=0.25
MIN_TRACK_LENGTH=30
TRACK_BUFFER=30
MAX_FRAMES=300
